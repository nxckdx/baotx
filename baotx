#!/usr/bin/env bash
set -eo pipefail

# BaoTx - Context & Login Manager for OpenBao / Vault
# Refactored for dynamic subcommands

# Handle multiple config files (like KUBECONFIG)
VERSION="1.7.0"
readonly VERSION
IFS=':' read -ra CONFIG_FILES <<< "${BAOTX_CONFIG:-$HOME/.baoconfig.yaml}"
readonly PRIMARY_CONFIG="${CONFIG_FILES[0]}"
readonly SCRIPT_PATH="$(realpath "$0")"
readonly DATA_DIR="$HOME/.local/share/baotx"
readonly REPO_OWNER="nxckdx"
readonly REPO_NAME="baotx"

# --- Helper Functions ---

_log() { echo -e "$*" >&2; }
_error() { _log "Error: $*"; exit 1; }

# GNU date (-d, -Iseconds) and BSD/macOS date (-v, -j -f) are incompatible.
# Prefer a GNU-compatible date binary (native, or Homebrew's coreutils
# "gdate" on macOS) and fall back to native BSD syntax otherwise.
_DATE_BIN="date"
if ! date --version >/dev/null 2>&1 && command -v gdate >/dev/null 2>&1; then
    _DATE_BIN="gdate"
fi
readonly _DATE_BIN

_is_gnu_date() { "$_DATE_BIN" --version >/dev/null 2>&1; }

_epoch_now() { "$_DATE_BIN" +%s; }

# Parse an ISO-8601 timestamp (as written by _iso_now/_iso_plus_seconds) into epoch seconds.
_epoch_from_iso() {
    local iso="$1"
    if _is_gnu_date; then
        "$_DATE_BIN" -d "$iso" +%s 2>/dev/null
    else
        # BSD/macOS strptime's %z wants "+HHMM", not "+HH:MM"
        "$_DATE_BIN" -j -f "%Y-%m-%dT%H:%M:%S%z" "$(echo "$iso" | sed -E 's/([+-][0-9]{2}):([0-9]{2})$/\1\2/')" +%s 2>/dev/null
    fi
}

_iso_now() {
    if _is_gnu_date; then
        "$_DATE_BIN" -Iseconds
    else
        "$_DATE_BIN" "+%Y-%m-%dT%H:%M:%S%z" | sed -E 's/([+-][0-9]{2})([0-9]{2})$/\1:\2/'
    fi
}

# ISO-8601 timestamp for "now + N seconds".
_iso_plus_seconds() {
    local secs="$1"
    if _is_gnu_date; then
        "$_DATE_BIN" -d "+$secs seconds" -Iseconds
    else
        "$_DATE_BIN" -j -v+"${secs}"S "+%Y-%m-%dT%H:%M:%S%z" | sed -E 's/([+-][0-9]{2})([0-9]{2})$/\1:\2/'
    fi
}

_get_config() {
    local query="$1"
    # Optional 2nd arg: extra yq flags, e.g. "-o=json" when the result will be
    # fed to jq (yq's default output is YAML, which jq cannot parse).
    local yq_flags=()
    [[ -n "${2:-}" ]] && yq_flags=("$2")
    local files=()
    # Check which files actually exist
    for f in "${CONFIG_FILES[@]}"; do
        [[ -f "$f" ]] && files+=("$f")
    done

    if [[ ${#files[@]} -eq 0 ]]; then
        return
    elif [[ ${#files[@]} -eq 1 ]]; then
        yq "${yq_flags[@]}" "$query" "${files[0]}" 2>/dev/null
    else
        # Merge files: the first one in the list has the highest precedence.
        # yq merges from left to right, where right overwrites left.
        # So we reverse the list for the 'ireduce' operation.
        local rev_files=()
        for (( i=${#files[@]}-1; i>=0; i-- )); do
            rev_files+=("${files[i]}")
        done
        yq eval-all "${yq_flags[@]}" ". as \$item ireduce ({}; . * \$item) | $query" "${rev_files[@]}" 2>/dev/null
    fi
}

_set_config() {
    # Write operations always target the primary (first) config file
    if [[ ! -f "$PRIMARY_CONFIG" ]]; then
        # Create it if it doesn't exist yet
        touch "$PRIMARY_CONFIG"
        chmod 600 "$PRIMARY_CONFIG"
    fi
    yq -i "$1" "$PRIMARY_CONFIG"
}

_check_deps() {
    for cmd in fzf jq yq curl; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            _error "Required tool \"$cmd\" is not installed."
        fi
    done

    # There are two unrelated tools called "yq": the Go-based one by Mikefarah
    # (https://github.com/mikefarah/yq) which BaoTx requires, and a Python
    # wrapper around jq (https://github.com/kislyuk/yq) with different syntax
    # (no `eval-all`, no `ireduce`, different -i semantics). Detect the wrong one early.
    if ! yq --version 2>&1 | grep -qi "mikefarah"; then
        _error "The installed 'yq' is not the required one. BaoTx needs the Go-based yq by Mikefarah (https://github.com/mikefarah/yq), not the Python 'yq' wrapper around jq. Please install the correct one."
    fi

    mkdir -p "$DATA_DIR"
}

_get_storage_backend() {
    local backend
    backend=$(_get_config '.token_storage // "keyring"')
    echo "$backend"
}

_store_token() {
    local cluster="$1" token="$2"
    local backend
    backend=$(_get_storage_backend)

    case "$backend" in
        keyring)
            if command -v secret-tool >/dev/null 2>&1; then
                secret-tool store --label="BaoTx: $cluster" service baotx cluster "$cluster" <<< "$token"
            elif command -v security >/dev/null 2>&1; then
                security add-generic-password -a "$USER" -s "baotx-$cluster" -w "$token" -U
            else
                _log "Warning: No keyring tool found. Falling back to plain text."
                _set_config ".clusters.\"$cluster\".token = \"$token\""
            fi
            ;;
        gpg)
            local key_id
            key_id=$(_get_config '.storage_key')
            [[ -z "$key_id" || "$key_id" == "null" ]] && _error "token_storage is 'gpg' but storage_key (GPG Key ID) is not set."
            echo "$token" | gpg --encrypt --recipient "$key_id" --armor > "$DATA_DIR/$cluster.gpg"
            ;;
        age)
            local key_id
            key_id=$(_get_config '.storage_key')
            [[ -z "$key_id" || "$key_id" == "null" ]] && _error "token_storage is 'age' but storage_key (Public Key) is not set."
            echo "$token" | age -r "$key_id" -a > "$DATA_DIR/$cluster.age"
            ;;
        plain)
            _set_config ".clusters.\"$cluster\".token = \"$token\""
            ;;
        *) _error "Unknown token_storage backend: $backend" ;;
    esac
}

_retrieve_token() {
    local cluster="$1"
    local backend token
    backend=$(_get_storage_backend)

    case "$backend" in
        keyring)
            if command -v secret-tool >/dev/null 2>&1; then
                token=$(secret-tool lookup service baotx cluster "$cluster")
            elif command -v security >/dev/null 2>&1; then
                token=$(security find-generic-password -a "$USER" -s "baotx-$cluster" -w 2>/dev/null)
            fi
            ;;
        gpg)
            if [[ -f "$DATA_DIR/$cluster.gpg" ]]; then
                token=$(gpg --decrypt "$DATA_DIR/$cluster.gpg" 2>/dev/null)
            fi
            ;;
        age)
            local identity
            identity=$(_get_config '.storage_identity') # age needs a private key/identity file for decryption
            if [[ -f "$DATA_DIR/$cluster.age" ]]; then
                if [[ -n "$identity" && "$identity" != "null" ]]; then
                    token=$(age --decrypt -i "$identity" "$DATA_DIR/$cluster.age" 2>/dev/null)
                else
                    token=$(age --decrypt "$DATA_DIR/$cluster.age" 2>/dev/null)
                fi
            fi
            ;;
        plain)
            token=$(_get_config ".clusters.\"$cluster\".token // \"\"")
            ;;
    esac

    # Fallback to config file if not found in backend (for transition)
    if [[ -z "$token" || "$token" == "null" ]]; then
        token=$(_get_config ".clusters.\"$cluster\".token // \"\"")
    fi
    echo "$token"
}

_delete_token() {
    local cluster="$1"
    local backend
    backend=$(_get_storage_backend)

    case "$backend" in
        keyring)
            if command -v secret-tool >/dev/null 2>&1; then
                secret-tool clear service baotx cluster "$cluster"
            elif command -v security >/dev/null 2>&1; then
                security delete-generic-password -a "$USER" -s "baotx-$cluster" 2>/dev/null || true
            fi
            ;;
        gpg) rm -f "$DATA_DIR/$cluster.gpg" ;;
        age) rm -f "$DATA_DIR/$cluster.age" ;;
    esac
    _set_config "del(.clusters.\"$cluster\".token)"
}

_get_cli_tool() {
    local tool
    tool=$(_get_config '.cli_tool // ""')
    if [[ -z "$tool" || "$tool" == "null" ]]; then
        if command -v bao >/dev/null 2>&1; then tool="bao"
        elif command -v vault >/dev/null 2>&1; then tool="vault"
        else tool="curl"; fi
    fi
    echo "$tool"
}

_resolve_alias() {
    local target="$1"
    # 1. Check if it's a direct cluster name
    if [[ $(_get_config ".clusters.\"$target\"") != "null" ]]; then
        echo "$target"
        return
    fi
    # 2. Check if it's an alias
    # This query finds the key of a cluster that has the target in its aliases list
    local resolved
    resolved=$(_get_config ".clusters | to_entries | .[] | select(.value.aliases[] == \"$target\") | .key")
    if [[ -n "$resolved" && "$resolved" != "null" ]]; then
        echo "$resolved"
    else
        echo "$target"
    fi
}

_is_insecure() {
    local cluster="$1"
    [[ -z "$cluster" || "$cluster" == "null" ]] && return 1
    local insecure
    insecure=$(_get_config ".clusters.\"$cluster\".insecure // .clusters.\"$cluster\".tls_skip_verify // .clusters.\"$cluster\".skip_verify // .clusters.\"$cluster\".env.VAULT_SKIP_VERIFY // .clusters.\"$cluster\".env.BAO_SKIP_VERIFY // false")
    if [[ "$insecure" == "true" || "$insecure" == "1" ]]; then
        return 0
    fi
    return 1
}

_check_health() {
    local addr="$1"
    local cluster="${2:-}"
    local curl_opts=(-s -f -m 2)
    if [[ -n "$cluster" ]] && _is_insecure "$cluster"; then
        curl_opts+=(-k)
    fi
    # Use a short timeout for health checks
    if curl "${curl_opts[@]}" "$addr/v1/sys/health" >/dev/null 2>&1; then
        echo "online"
    else
        echo "offline"
    fi
}

_export_context() {
    local cluster="$1" addr="$2" token="$3" ns="${4:-}" custom_env="${5:-}"
    
    # Unset previously exported custom variables to avoid leakage
    if [[ -n "${BAOTX_VARS:-}" ]]; then
        for var in $BAOTX_VARS; do
            echo "unset $var"
        done
    fi

    echo "export VAULT_ADDR=\"$addr\""
    echo "export VAULT_TOKEN=\"$token\""
    echo "export BAO_ADDR=\"$addr\""
    echo "export BAO_TOKEN=\"$token\""
    echo "export BAOTX_CLUSTER=\"$cluster\""
    
    if [[ -n "$ns" && "$ns" != "null" ]]; then
        echo "export VAULT_NAMESPACE=\"$ns\""
        echo "export BAO_NAMESPACE=\"$ns\""
    else
        echo "unset VAULT_NAMESPACE BAO_NAMESPACE"
    fi

    if _is_insecure "$cluster"; then
        echo "export VAULT_SKIP_VERIFY=\"1\""
        echo "export BAO_SKIP_VERIFY=\"1\""
    else
        echo "unset VAULT_SKIP_VERIFY BAO_SKIP_VERIFY"
    fi

    # Export custom environment variables
    local exported_vars=""
    if [[ -n "$custom_env" && "$custom_env" != "null" ]]; then
        # Parse the custom_env (which is a JSON string of the env map)
        while IFS='=' read -r key value; do
            if [[ -n "$key" ]]; then
                echo "export $key=\"$value\""
                exported_vars+="$key "
            fi
        done < <(echo "$custom_env" | jq -r 'to_entries | .[] | .key + "=" + (.value | tostring)' 2>/dev/null || true)
    fi
    echo "export BAOTX_VARS=\"${exported_vars% }\""
}

_baotx_logo(){
    _log "  ____              _______      "
    _log " |  _ \            |__   __|     "
    _log " | |_) | __ _  ___   | |_  __  "
    _log " |  _ < / _\` |/ _ \  | \ \/ /  "
    _log " | |_) | (_| | (_) | | |>  <   "
    _log " |____/ \__,_|\___/  |_/_/\_\  "
}

_run_hook() {
    local type="$1" # pre or post
    local cmd="$2"
    local cluster="$3"
    shift 3
    
    local hook_files=()
    # 1. Cluster-specific hook
    [[ -n "$cluster" && "$cluster" != "null" ]] && hook_files+=("$DATA_DIR/$cluster/${type}_${cmd}.sh")
    # 2. Global hook
    hook_files+=("$DATA_DIR/${type}_${cmd}.sh")

    for hook_file in "${hook_files[@]}"; do
        if [[ -x "$hook_file" ]]; then
            local hook_rc=0
            "$hook_file" "$@" >&2 || hook_rc=$?
            if [[ "$hook_rc" -ne 0 ]]; then
                if [[ "$type" == "pre" ]]; then
                    _error "Pre-hook '$hook_file' failed with exit code $hook_rc. Aborting."
                else
                    _log "Warning: Post-hook '$hook_file' failed with exit code $hook_rc."
                fi
            fi
        fi
    done
}

# --- Subcommand Functions ---

# DESC: Checks for updates and installs the latest version
cmd_update() {
    if [[ "$SCRIPT_PATH" == /nix/store/* ]]; then
        _error "BaoTx was installed via Nix/NixOS, so it lives in the read-only Nix store and cannot self-update. Update it via your flake input ('nix flake update baotx' + rebuild) or by bumping the nixpkgs/channel revision instead."
    fi

    local latest_version
    _log "Checking for updates..."
    latest_version=$(curl -s "https://api.github.com/repos/$REPO_OWNER/$REPO_NAME/releases/latest" | jq -r .tag_name)

    if [[ "$latest_version" == "null" ]]; then
        _error "Could not find any releases for $REPO_OWNER/$REPO_NAME."
    fi

    if [[ "$latest_version" == "$VERSION" ]]; then
        _log "BaoTx is already up to date ($VERSION)."
    else
        local install_dir
        install_dir=$(dirname "$SCRIPT_PATH")
        if [[ ! -w "$install_dir" ]]; then
            _error "No permission to write to $install_dir. Re-run with sudo, or reinstall BaoTx to a directory you own (e.g. ~/.local/bin)."
        fi

        _log "Updating BaoTx from $VERSION to $latest_version..."
        # Download to a temp file first
        local tmp_bin
        tmp_bin=$(mktemp) || _error "Could not create a temporary file (is \$TMPDIR writable?)."
        if curl -sSLf "https://github.com/$REPO_OWNER/$REPO_NAME/releases/latest/download/baotx" -o "$tmp_bin"; then
            chmod +x "$tmp_bin"
            mv "$tmp_bin" "$SCRIPT_PATH"
            _log "Update successful! Please restart your shell."
        else
            rm -f "$tmp_bin"
            _error "Download failed. The release asset might not be available yet."
        fi
    fi
}

# DESC: Shows this help message
cmd_help() {
    _baotx_logo
    _log ""
    _log "BaoTx - Context & Login Manager for OpenBao / Vault"
    _log "--------------------------------"
    _log "\nUsage: baotx <command> [arguments]\n"
    _log "Commands:"
    
    # Dynamically extract commands and their DESC comments
    grep -E "^# DESC:|^cmd_" "$SCRIPT_PATH" | while read -r line; do
        if [[ "$line" =~ ^#\ DESC:\ (.*) ]]; then
            desc="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ ^cmd_([a-zA-Z0-9_-]+)\(\) ]]; then
            name="${BASH_REMATCH[1]}"
            printf "  %-15s %s\n" "$name" "$desc" >&2
        fi
    done
    _log ""
    _log "Environment Variables:"
    _log "  BAOTX_CONFIG    Path to the config file (default: \$HOME/.baoconfig.yaml)"
    _log ""
}

# DESC: Initializes configuration or shell integration (usage: baotx init [config|zsh|bash])
cmd_init() {
    local target="${1:-config}"
    case "$target" in
        zsh|bash)
            cat <<EOF
baotx() {
    local out
    if [[ "\$1" == "exec" || "\$1" == "completion" || "\$1" == "init" || "\$*" == *"--format=json"* ]]; then
        command baotx "\$@"
        return \$?
    fi
    
    out=\$(command baotx "\$@")
    local ret=\$?
    if [[ -n "\$out" ]]; then
        if [[ "\$*" == *"--format=env"* ]]; then
            echo "\$out"
        fi
        eval "\$out"
    fi
    return \$ret
}
baotx load 2>/dev/null
source <(command baotx completion $target 2>/dev/null)
EOF
            ;;
        config)
            if [[ -f "$PRIMARY_CONFIG" ]]; then
                _error "Configuration file $PRIMARY_CONFIG already exists!"
            fi
            cat <<EOF > "$PRIMARY_CONFIG"
cli_tool: ""
token_storage: "keyring"
clusters:
  dev-cluster:
    address: "https://bao-dev.example.com"
    login: "userpass"
    username: ""
    aliases: ["dev", "d"]
    last_authentication: ""
    token: ""
    expire_token: ""
current-cluster: ""
EOF
            chmod 600 "$PRIMARY_CONFIG"
            _log "Template successfully created at $PRIMARY_CONFIG."
            ;;
        *) _error "Usage: baotx init [config|zsh|bash]" ;;
    esac
}

# Machine-readable counterpart to cmd_status's default text rendering.
# Emits one JSON object per cluster (a single object, or an array with --all).
_cmd_status_json() {
    local show_policies="$1" show_all="$2"

    local clusters_to_show=()
    if [[ "$show_all" -eq 1 ]]; then
        while read -r line; do [[ -n "$line" ]] && clusters_to_show+=("$line"); done < <(_get_config '.clusters | keys[]' 2>/dev/null)
    else
        local cur
        cur=$(_get_config '.current-cluster')
        if [[ -z "$cur" || "$cur" == "null" ]]; then
            echo "null"
            return
        fi
        clusters_to_show+=("$cur")
    fi

    local current_active
    current_active=$(_get_config '.current-cluster')

    local objects=()
    for cluster in "${clusters_to_show[@]}"; do
        local addr ns token cli_tool exp curl_insecure_arg=()
        addr=$(_get_config ".clusters.\"$cluster\".address")
        ns=$(_get_config ".clusters.\"$cluster\".namespace")
        token=$(_retrieve_token "$cluster")
        cli_tool=$(_get_cli_tool)
        exp=$(_get_config ".clusters.\"$cluster\".expire_token")

        if _is_insecure "$cluster"; then
            curl_insecure_arg=(-k)
            export VAULT_SKIP_VERIFY="1"
            export BAO_SKIP_VERIFY="1"
        else
            unset VAULT_SKIP_VERIFY BAO_SKIP_VERIFY
        fi

        local current_json="false"
        [[ "$cluster" == "$current_active" ]] && current_json="true"

        local ns_json="null"
        [[ -n "$ns" && "$ns" != "null" ]] && ns_json=$(jq -cn --arg v "$ns" '$v')

        local logged_in_json="false"
        local expires_at_json="null" expires_in_json="null" expired_json="null" policies_json="null"

        if [[ -n "$token" ]]; then
            logged_in_json="true"

            if [[ -n "$exp" && "$exp" != "null" ]]; then
                local diff
                diff=$(( $(_epoch_from_iso "$exp") - $(_epoch_now) ))
                expires_at_json=$(jq -cn --arg v "$exp" '$v')
                expires_in_json="$diff"
                (( diff <= 0 )) && expired_json="true" || expired_json="false"
            fi

            # Only pay for a policy lookup when showing a single cluster or when explicitly asked.
            if [[ "$show_all" -eq 0 || "$show_policies" -eq 1 ]]; then
                local lookup_json=""
                if [[ "$cli_tool" == "curl" ]]; then
                    lookup_json=$(curl -s -f "${curl_insecure_arg[@]}" -H "X-Vault-Token: $token" "$addr/v1/auth/token/lookup-self" 2>/dev/null || true)
                else
                    lookup_json=$(VAULT_ADDR="$addr" VAULT_TOKEN="$token" "$cli_tool" token lookup -format=json 2>/dev/null || true)
                fi
                if [[ -n "$lookup_json" ]]; then
                    policies_json=$(echo "$lookup_json" | jq -c '[(.data.policies + (.data.identity_policies // [])) | unique[]]' 2>/dev/null || echo "null")
                fi
            fi
        fi

        objects+=("$(jq -n \
            --arg cluster "$cluster" \
            --argjson current "$current_json" \
            --arg address "$addr" \
            --argjson namespace "$ns_json" \
            --argjson logged_in "$logged_in_json" \
            --argjson expires_at "$expires_at_json" \
            --argjson expires_in_seconds "$expires_in_json" \
            --argjson expired "$expired_json" \
            --argjson policies "$policies_json" \
            '{cluster:$cluster,current:$current,address:$address,namespace:$namespace,logged_in:$logged_in,expires_at:$expires_at,expires_in_seconds:$expires_in_seconds,expired:$expired,policies:$policies}')")
    done

    if [[ "$show_all" -eq 1 ]]; then
        printf '%s\n' "${objects[@]}" | jq -s '.'
    else
        echo "${objects[0]}"
    fi
}

# DESC: Shows current context and token TTL (use --format=env for .env output, --format=json for machine-readable output, --policies for policy details, --all for all clusters)
cmd_status() {
    local format="" show_policies=0 show_all=0
    for arg in "$@"; do
        case "$arg" in
            --format=env) format="env" ;;
            --format=json) format="json" ;;
            --policies) show_policies=1 ;;
            --all) show_all=1 ;;
        esac
    done

    if [[ "$format" == "env" ]]; then
        local cur
        cur=$(_get_config '.current-cluster')
        if [[ -n "$cur" && "$cur" != "null" ]]; then
            local addr token ns custom_env
            addr=$(_get_config ".clusters.\"$cur\".address")
            token=$(_retrieve_token "$cur")
            ns=$(_get_config ".clusters.\"$cur\".namespace")
            custom_env=$(_get_config ".clusters.\"$cur\".env" "-o=json")

            _export_context "$cur" "$addr" "$token" "$ns" "$custom_env"
        fi
        return
    fi

    if [[ "$format" == "json" ]]; then
        _cmd_status_json "$show_policies" "$show_all"
        return
    fi

    _baotx_logo
    _log ""

    local clusters_to_show=()
    if [[ "$show_all" -eq 1 ]]; then
        # Get all cluster keys
        while read -r line; do [[ -n "$line" ]] && clusters_to_show+=("$line"); done < <(_get_config '.clusters | keys[]' 2>/dev/null)
    else
        local cur
        cur=$(_get_config '.current-cluster')
        if [[ -z "$cur" || "$cur" == "null" ]]; then
            _log "No cluster selected. Use --all to see all clusters."
            return
        fi
        clusters_to_show+=("$cur")
    fi

    local current_active
    current_active=$(_get_config '.current-cluster')

    for cluster in "${clusters_to_show[@]}"; do
        local addr exp ns diff hours mins token cli_tool curl_insecure_arg=()
        addr=$(_get_config ".clusters.\"$cluster\".address")
        exp=$(_get_config ".clusters.\"$cluster\".expire_token")
        ns=$(_get_config ".clusters.\"$cluster\".namespace")
        token=$(_retrieve_token "$cluster")
        cli_tool=$(_get_cli_tool)

        if _is_insecure "$cluster"; then
            curl_insecure_arg=(-k)
            export VAULT_SKIP_VERIFY="1"
            export BAO_SKIP_VERIFY="1"
        else
            unset VAULT_SKIP_VERIFY BAO_SKIP_VERIFY
        fi

        local prefix="  "
        [[ "$cluster" == "$current_active" ]] && prefix="* "

        _log "${prefix}Cluster:   $cluster"
        _log "  Address:   $addr"
        [[ -n "$ns" && "$ns" != "null" ]] && _log "  Namespace: $ns"
        
        if [[ -n "$token" ]]; then
            if [[ -n "$exp" && "$exp" != "null" ]]; then
                diff=$(( $(_epoch_from_iso "$exp") - $(_epoch_now) ))
                if (( diff <= 0 )); then
                    _log "  Token:     EXPIRED"
                else
                    hours=$((diff / 3600))
                    mins=$(( (diff % 3600) / 60 ))
                    _log "  Token:     Valid for ${hours}h ${mins}m"
                fi
            else
                _log "  Token:     Valid (no expiry set)"
            fi

            # Policies (only if single cluster or --policies requested)
            if [[ "$show_all" -eq 0 || "$show_policies" -eq 1 ]]; then
                local policies=""
                if [[ "$cli_tool" == "curl" ]]; then
                    local lookup_json
                    lookup_json=$(curl -s -f "${curl_insecure_arg[@]}" -H "X-Vault-Token: $token" "$addr/v1/auth/token/lookup-self" 2>/dev/null || true)
                    if [[ -n "$lookup_json" ]]; then
                        policies=$(echo "$lookup_json" | jq -r '(.data.policies + (.data.identity_policies // [])) | unique | join(", ")')
                    fi
                else
                    local lookup_json
                    lookup_json=$(VAULT_ADDR="$addr" VAULT_TOKEN="$token" "$cli_tool" token lookup -format=json 2>/dev/null || true)
                    if [[ -n "$lookup_json" ]]; then
                        policies=$(echo "$lookup_json" | jq -r '(.data.policies + (.data.identity_policies // [])) | unique | join(", ")')
                    fi
                fi
                [[ -z "$policies" || "$policies" == "null" ]] && policies="unknown"
                _log "  Policies:  $policies"
            fi

            if [[ "$show_policies" -eq 1 ]]; then
                _log "  --- Policy Details (excluding 'default') ---"
                local policy_list
                policy_list=$(echo "$policies" | tr -d ',' | tr ' ' '\n' | grep -v "^default$" || true)
                for p in $policy_list; do
                    _log "  [ Policy: $p ]"
                    local content=""
                    if [[ "$cli_tool" == "curl" ]]; then
                        content=$(curl -s -f "${curl_insecure_arg[@]}" -H "X-Vault-Token: $token" "$addr/v1/sys/policies/acl/$p" | jq -r '.data.policy' 2>/dev/null || true)
                    else
                        content=$(VAULT_ADDR="$addr" VAULT_TOKEN="$token" "$cli_tool" policy read -format=json "$p" 2>/dev/null | jq -r '.policy' 2>/dev/null || true)
                    fi

                    if [[ -n "$content" ]]; then
                        # Indent policy content
                        echo "$content" | sed 's/^/    /' >&2
                    else
                        _log "    (Access denied or empty)"
                    fi
                done
            fi
        else
            _log "  Token:     NOT LOGGED IN"
        fi
        _log ""
    done
}

# DESC: Silently loads the current context (used for .zshrc)
cmd_load() {
    local cur addr token ns custom_env
    cur=$(_get_config '.current-cluster')
    if [[ -n "$cur" && "$cur" != "null" ]]; then
        addr=$(_get_config ".clusters.\"$cur\".address")
        token=$(_retrieve_token "$cur")
        ns=$(_get_config ".clusters.\"$cur\".namespace")
        custom_env=$(_get_config ".clusters.\"$cur\".env" "-o=json")
        _export_context "$cur" "$addr" "$token" "$ns" "$custom_env"
    fi
}

# DESC: Clears current context and environment variables
cmd_clear() {
    local cur
    cur=$(_get_config '.current-cluster')
    if [[ -n "$cur" && "$cur" != "null" ]]; then
        _delete_token "$cur"
    fi
    _set_config '.current-cluster = ""'
    _log "Context cleared."
    
    local unset_cmd="unset VAULT_ADDR VAULT_TOKEN BAO_ADDR BAO_TOKEN BAOTX_CLUSTER VAULT_NAMESPACE BAO_NAMESPACE VAULT_SKIP_VERIFY BAO_SKIP_VERIFY"
    if [[ -n "${BAOTX_VARS:-}" ]]; then
        for var in $BAOTX_VARS; do
            unset_cmd+=" $var"
        done
        unset_cmd+=" BAOTX_VARS"
    fi
    echo "$unset_cmd"
}

# DESC: Renews the current token lease
cmd_renew() {
    local cur addr token cli_tool
    cur=$(_get_config '.current-cluster')
    if [[ -z "$cur" || "$cur" == "null" ]]; then
        _error "No cluster selected. Run 'baotx select' first."
    fi

    addr=$(_get_config ".clusters.\"$cur\".address")
    token=$(_retrieve_token "$cur")
    cli_tool=$(_get_cli_tool)

    if [[ -z "$token" || "$token" == "null" ]]; then
        _error "Not logged into $cur. Run 'baotx login' first."
    fi

    _log "Renewing token for $cur..."
    local renew_json dur exp_token
    if [[ "$cli_tool" == "curl" ]]; then
        renew_json=$(curl -s -f -X POST -H "X-Vault-Token: $token" "$addr/v1/auth/token/renew-self" 2>/dev/null || true)
    else
        renew_json=$(VAULT_ADDR="$addr" VAULT_TOKEN="$token" "$cli_tool" token renew -format=json 2>/dev/null || true)
    fi

    if [[ -z "$renew_json" || "$renew_json" == "null" ]]; then
        _error "Token renewal failed. You might need to re-authenticate with 'baotx login'."
    fi

    # Lease duration can be in .auth.lease_duration or top-level .lease_duration
    dur=$(echo "$renew_json" | jq -r '(.auth.lease_duration // .lease_duration)')
    
    if [[ -z "$dur" || "$dur" == "null" ]]; then
         _error "Could not determine new lease duration."
    fi

    exp_token=$(_iso_plus_seconds "$dur")
    _set_config ".clusters.\"$cur\".expire_token = \"$exp_token\""
    _log "Token successfully renewed. Valid until: $exp_token"
}

# DESC: Alias for clear
cmd_unset() { cmd_clear; }

# DESC: Sets the path to the bao/vault binary
cmd_set-cli() {
    if [[ -z "${1:-}" ]]; then _error "Usage: baotx set-cli <path>"; fi
    _set_config ".cli_tool = \"$1\""
    _log "CLI tool updated to: $1"
}

# DESC: Selects a cluster (interactive via fzf if no name given)
cmd_select() {
    local selected="$1"
    local cli_tool clusters
    cli_tool=$(_get_cli_tool)

    if [[ "$selected" == "-" ]]; then
        selected=$(_get_config '.previous-cluster // ""')
        if [[ -z "$selected" || "$selected" == "null" ]]; then
            _error "No previous cluster found."
        fi
    fi

    if [[ -z "$selected" ]]; then
        # We use a temporary file to store health results to avoid blocking fzf
        local health_tmp
        health_tmp=$(mktemp) || _error "Could not create a temporary file (is \$TMPDIR writable?)."
        
        # Get clusters and their addresses
        local cluster_data
        cluster_data=$(_get_config '.clusters | to_entries | .[] | .key + " " + .value.address')

        # Start health checks in background
        while read -r name addr; do
            (
                local status
                status=$(_check_health "$addr" "$name")
                echo "$name $status" >> "$health_tmp"
            ) &
        done <<< "$cluster_data"

        # Prepare the list for fzf with ansi colors
        # This is a bit tricky: we want fzf to show the list immediately,
        # but we also want the colors. Since the background checks might take a second,
        # we'll build a preview/list that includes the status.
        
        # Wait a tiny bit for the first results, but not too long
        sleep 0.2

        local fzf_input
        fzf_input=$(while read -r name addr; do
            local aliases status_color="[..]" status_text=""
            aliases=$(_get_config ".clusters.\"$name\".aliases | join(\", \")" 2>/dev/null || echo "")
            [[ "$aliases" == "null" ]] && aliases=""
            
            # Check if we already have a health result
            local health
            health=$(grep "^$name " "$health_tmp" | cut -d' ' -f2 || true)
            
            if [[ "$health" == "online" ]]; then
                status_color="\e[32m[ok]\e[0m"
            elif [[ "$health" == "offline" ]]; then
                status_color="\e[31m[!!]\e[0m"
            fi

            local display_name="$name"
            [[ -n "$aliases" ]] && display_name="$name [$aliases]"
            
            printf "%-30s %b\n" "$display_name" "$status_color"
        done <<< "$cluster_data")

        selected=$(echo -e "$fzf_input" | fzf --ansi \
            --prompt="${cli_tool^^} Cluster > " \
            --height=40% --layout=reverse \
            --header="[ok]=Online  [!!]=Offline  [..]=Checking...")
        
        rm -f "$health_tmp"
        
        # Strip aliases and status from selection
        selected="${selected%% *}"
    else
        selected=$(_resolve_alias "$selected")
    fi

    [[ -z "$selected" || "$selected" == "null" ]] && return

    _perform_switch "$selected" 0
}

# DESC: Selects a namespace for the current cluster
cmd_namespace() {
    local cur selected cli_tool addr token namespaces exp_token
    cur=$(_get_config '.current-cluster')
    if [[ -z "$cur" || "$cur" == "null" ]]; then
        _error "No cluster selected. Run 'baotx select' first."
    fi

    selected="${1:-}"
    if [[ "$selected" == "-" ]]; then
        selected=$(_get_config ".clusters.\"$cur\".previous-namespace // \"\"")
        if [[ -z "$selected" || "$selected" == "null" ]]; then
            _error "No previous namespace found for cluster $cur."
        fi
    fi

    # Check if we need a login, but don't force a switch/export yet
    cli_tool=$(_get_cli_tool)
    addr=$(_get_config ".clusters.\"$cur\".address")
    token=$(_retrieve_token "$cur")
    exp_token=$(_get_config ".clusters.\"$cur\".expire_token")

    local needs_login=0
    if [[ -z "$token" || "$token" == "null" ]]; then needs_login=1
    elif [[ -n "$exp_token" && "$exp_token" != "null" ]]; then
        [[ $(_epoch_from_iso "$exp_token") -lt $(_epoch_now) ]] && needs_login=1
    fi
    
    # If token is expired or missing, perform a normal switch (which handles login)
    if [[ "$needs_login" -eq 1 ]]; then
        eval "$(_perform_switch "$cur" 0)" >/dev/null
        token=$(_retrieve_token "$cur")
    fi

    if [[ -z "$selected" ]]; then
        _log "Fetching namespaces from $cur..."

        if [[ "$cli_tool" == "curl" ]]; then
            local curl_insecure_arg=()
            _is_insecure "$cur" && curl_insecure_arg=(-k)
            namespaces=$(curl -s -f "${curl_insecure_arg[@]}" -H "X-Vault-Token: $token" "$addr/v1/sys/namespaces?list=true" | jq -r '.data.keys[]' 2>/dev/null || true)
        else
            local skip_verify=""
            _is_insecure "$cur" && skip_verify="1"
            namespaces=$(VAULT_ADDR="$addr" VAULT_TOKEN="$token" VAULT_NAMESPACE="" VAULT_SKIP_VERIFY="$skip_verify" BAO_SKIP_VERIFY="$skip_verify" "$cli_tool" namespace list -format=json 2>/dev/null | jq -r '.[]' 2>/dev/null || true)
        fi

        # Add root option and clean up
        namespaces=$(echo -e "root\n$namespaces" | grep -v "^null$" | sed 's/\/$//' | sort -u || echo "root")

        selected=$(echo "$namespaces" | fzf --prompt="Namespace > " --height=40% --layout=reverse)
    fi

    [[ -z "$selected" ]] && return

    # Save previous namespace
    local old_ns ns_history_cmd=""
    old_ns=$(_get_config ".clusters.\"$cur\".namespace // \"root\"")
    if [[ "$old_ns" != "$selected" ]]; then
        ns_history_cmd=".clusters.\"$cur\".previous-namespace = \"$old_ns\" | "
    fi

    local custom_env
    custom_env=$(_get_config ".clusters.\"$cur\".env" "-o=json")

    if [[ "$selected" == "root" ]]; then
        _set_config "${ns_history_cmd}del(.clusters.\"$cur\".namespace)"
        _log "Namespace cleared (root)."
        _export_context "$cur" "$addr" "$token" "" "$custom_env"
    else
        _set_config "${ns_history_cmd}.clusters.\"$cur\".namespace = \"$selected\""
        _log "Namespace set to: $selected"
        _export_context "$cur" "$addr" "$token" "$selected" "$custom_env"
    fi
}

# DESC: Alias for namespace
cmd_ns() { cmd_namespace "$@"; }

# DESC: Forces a login for a cluster (defaults to current)
cmd_login() {
    local selected="${1:-}"
    local method="${2:-}"
    
    # If no argument, try to get the current cluster
    if [[ -z "$selected" ]]; then
        selected=$(_get_config '.current-cluster')
    else
        selected=$(_resolve_alias "$selected")
    fi

    if [[ -z "$selected" || "$selected" == "null" ]]; then
        _error "No cluster specified and no current cluster set. Use 'baotx select' first."
    fi
    
    _perform_switch "$selected" 1 "$method"
}

# Internal function for switching and login logic
_perform_switch() {
    local selected="$1"
    local force_login="$2"
    local override_method="${3:-}"
    local addr login_method token exp_token cli_tool ns custom_env username
    
    addr=$(_get_config ".clusters.\"$selected\".address")
    if [[ "$addr" == "null" ]]; then _error "Cluster \"$selected\" not found."; fi
    
    # Logic to handle login as a string or a list
    if [[ -n "$override_method" ]]; then
        login_method="$override_method"
    else
        # yq query: if it's a sequence, take the first element, otherwise take the value
        login_method=$(_get_config "(.clusters.\"$selected\".login | (select(tag == \"!!seq\") | .[0]) // .)")
    fi

    token=$(_retrieve_token "$selected")
    exp_token=$(_get_config ".clusters.\"$selected\".expire_token")
    ns=$(_get_config ".clusters.\"$selected\".namespace")
    cli_tool=$(_get_cli_tool)
    custom_env=$(_get_config ".clusters.\"$selected\".env" "-o=json")

    # Export variables temporarily for validation checks and login
    if [[ -n "$ns" && "$ns" != "null" ]]; then
        export VAULT_NAMESPACE="$ns"
        export BAO_NAMESPACE="$ns"
    fi

    if _is_insecure "$selected"; then
        export VAULT_SKIP_VERIFY="1"
        export BAO_SKIP_VERIFY="1"
    fi

    if [[ -n "$custom_env" && "$custom_env" != "null" ]]; then
        while IFS='=' read -r key value; do
            if [[ -n "$key" ]]; then
                export "$key"="$value"
            fi
        done < <(echo "$custom_env" | jq -r 'to_entries | .[] | .key + "=" + (.value | tostring)' 2>/dev/null || true)
    fi

    local needs_login="$force_login"
    if [[ "$needs_login" -eq 0 ]]; then
        if [[ -z "$token" || "$token" == "null" ]]; then needs_login=1
        elif [[ -n "$exp_token" && "$exp_token" != "null" ]]; then
            [[ $(_epoch_from_iso "$exp_token") -lt $(_epoch_now) ]] && needs_login=1
        fi
        
        if [[ "$needs_login" -eq 0 ]]; then
            if [[ "$cli_tool" == "curl" ]]; then
                local curl_args=(-s -f -H "X-Vault-Token: $token")
                _is_insecure "$selected" && curl_args+=(-k)
                if [[ -n "$ns" && "$ns" != "null" ]]; then
                    curl_args+=(-H "X-Vault-Namespace: $ns")
                fi
                ! curl "${curl_args[@]}" "$addr/v1/auth/token/lookup-self" >/dev/null 2>&1 && needs_login=1
            else
                ! VAULT_ADDR="$addr" VAULT_TOKEN="$token" "$cli_tool" token lookup >/dev/null 2>&1 && needs_login=1
            fi
        fi
    fi

    local current
    current=$(_get_config '.current-cluster')
    local history_cmd=""
    if [[ -n "$current" && "$current" != "null" && "$current" != "$selected" ]]; then
        history_cmd=".previous-cluster = \"$current\" | "
    fi

    if [[ "$needs_login" -eq 1 ]]; then
        if [[ "$cli_tool" == "curl" ]]; then _error "Login not possible via curl. Install bao/vault."; fi
        _log "Logging into $selected..."
        
        username=$(_get_config ".clusters.\"$selected\".username // \"\"")
        if [[ -z "$username" || "$username" == "null" ]]; then
            if [[ "$login_method" == "userpass" || "$login_method" == "ldap" || "$login_method" == "radius" || "$login_method" == "okta" ]]; then
                if [[ -t 0 ]]; then
                    read -r -p "Username: " username
                elif [[ -c /dev/tty ]]; then
                    read -r -p "Username: " username </dev/tty
                fi
            fi
        fi

        local extra_args=()
        if _is_insecure "$selected"; then
            extra_args+=("-tls-skip-verify")
        fi
        if [[ -n "$username" && "$username" != "null" ]]; then
            extra_args+=("username=$username")
        fi

        local login_json dur now
        login_json=$("$cli_tool" login -method="$login_method" -address="$addr" -format=json "${extra_args[@]}") || _error "Login failed!"
        
        token=$(echo "$login_json" | jq -r '.auth.client_token')
        dur=$(echo "$login_json" | jq -r '.auth.lease_duration')
        exp_token=$(_iso_plus_seconds "$dur")
        now=$(_iso_now)
        
        _store_token "$selected" "$token"
        _set_config "${history_cmd}.clusters.\"$selected\".expire_token = \"$exp_token\" | .clusters.\"$selected\".last_authentication = \"$now\" | .current-cluster = \"$selected\""
        _log "Login successful. Valid until: $exp_token"
    else
        _log "Switched to $selected"
        _set_config "${history_cmd}.current-cluster = \"$selected\""
    fi

    _export_context "$selected" "$addr" "$token" "$ns" "$custom_env"
}

# DESC: Runs a command in a specific cluster context
cmd_exec() {
    local target="$1"
    shift
    if [[ -z "$target" || "$target" == -* || -z "$1" ]]; then
        _log "Usage: baotx exec <cluster|alias> <command> [args...]"
        exit 1
    fi

    local cluster
    cluster=$(_resolve_alias "$target")
    
    local addr token ns custom_env
    addr=$(_get_config ".clusters.\"$cluster\".address")
    if [[ "$addr" == "null" ]]; then _error "Cluster \"$cluster\" not found."; fi

    token=$(_retrieve_token "$cluster")
    ns=$(_get_config ".clusters.\"$cluster\".namespace")
    custom_env=$(_get_config ".clusters.\"$cluster\".env" "-o=json")

    # Export variables so they are available for token validation and the executed command
    export VAULT_ADDR="$addr"
    export VAULT_TOKEN="$token"
    export BAO_ADDR="$addr"
    export BAO_TOKEN="$token"
    export BAOTX_CLUSTER="$cluster"
    if [[ -n "$ns" && "$ns" != "null" ]]; then
        export VAULT_NAMESPACE="$ns"
        export BAO_NAMESPACE="$ns"
    fi

    if _is_insecure "$cluster"; then
        export VAULT_SKIP_VERIFY="1"
        export BAO_SKIP_VERIFY="1"
    fi

    if [[ -n "$custom_env" && "$custom_env" != "null" ]]; then
        while IFS='=' read -r key value; do
            if [[ -n "$key" ]]; then
                export "$key"="$value"
            fi
        done < <(echo "$custom_env" | jq -r 'to_entries | .[] | .key + "=" + (.value | tostring)' 2>/dev/null || true)
    fi

    # Check if login is needed
    local needs_login=0
    if [[ -z "$token" || "$token" == "null" ]]; then
        needs_login=1
    else
        local exp_token cli_tool
        exp_token=$(_get_config ".clusters.\"$cluster\".expire_token")
        if [[ -n "$exp_token" && "$exp_token" != "null" ]]; then
            [[ $(_epoch_from_iso "$exp_token") -lt $(_epoch_now) ]] && needs_login=1
        fi
        
        if [[ "$needs_login" -eq 0 ]]; then
            cli_tool=$(_get_cli_tool)
            if [[ "$cli_tool" == "curl" ]]; then
                local curl_args=(-s -f -H "X-Vault-Token: $token")
                _is_insecure "$cluster" && curl_args+=(-k)
                if [[ -n "$ns" && "$ns" != "null" ]]; then
                    curl_args+=(-H "X-Vault-Namespace: $ns")
                fi
                ! curl "${curl_args[@]}" "$addr/v1/auth/token/lookup-self" >/dev/null 2>&1 && needs_login=1
            else
                ! VAULT_ADDR="$addr" VAULT_TOKEN="$token" "$cli_tool" token lookup >/dev/null 2>&1 && needs_login=1
            fi
        fi
    fi

    if [[ "$needs_login" -eq 1 ]]; then
        _log "Authentication required for $cluster..."
        _perform_switch "$cluster" 1 >/dev/null
        token=$(_retrieve_token "$cluster")
        # Re-export updated token
        export VAULT_TOKEN="$token"
        export BAO_TOKEN="$token"
    fi

    exec "$@"
}

# DESC: Generates auto-completion scripts
cmd_completion() {
    local shell="$1"
    local name desc
    local cmd_list_zsh="" cmd_list_bash=""

    # Dynamically discover commands and descriptions
    while read -r line; do
        if [[ "$line" =~ ^#\ DESC:\ (.*) ]]; then
            desc="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ ^cmd_([a-zA-Z0-9_-]+)\(\) ]]; then
            name="${BASH_REMATCH[1]}"
            local escaped_desc="${desc//\'/\'\'}"
            cmd_list_zsh+="'$name:$escaped_desc' "
            cmd_list_bash+="$name "
        fi
    done < <(grep -E "^# DESC:|^cmd_" "$SCRIPT_PATH")

    case "$shell" in
        zsh)
            cat << 'EOF' | sed "s@##CMD_LIST_ZSH##@$cmd_list_zsh@g"
_baotx_completion() {
    local -a baotx_clusters
    local config_list="${BAOTX_CONFIG:-$HOME/.baoconfig.yaml}"
    
    # ZSH-idiomatic way to split string into array
    local -a configs
    configs=("${(@s.:.)config_list}")

    local -a existing_configs
    for f in "${configs[@]}"; do [[ -f "$f" ]] && existing_configs+=("$f"); done

    if [[ ${#existing_configs[@]} -gt 0 ]]; then
        # Get both cluster names and their aliases from all files
        baotx_clusters=(${(f)"$(yq eval-all '(.clusters // {}) | to_entries | .[] | (.key, (.value.aliases // [] | .[]))' "${existing_configs[@]}" 2>/dev/null | grep -v "^null$" || true)"})
    fi

    if (( CURRENT == 2 )); then
        local -a cmds
        cmds=( ##CMD_LIST_ZSH## )
        _describe -t commands 'baotx commands' cmds
    elif (( CURRENT == 3 )); then
        case "$words[2]" in
            login|select|namespace|ns|exec)
                _describe -t clusters 'clusters' baotx_clusters
                ;;
            status)
                local -a flags
                flags=('--format=env:Output environment variables' '--format=json:Output machine-readable JSON' '--policies:Show policy details' '--all:Show status of all clusters')
                _describe -t flags 'flags' flags
                ;;
            set-cli)
                _files
                ;;
        esac
    fi
}
compdef _baotx_completion baotx
EOF
            ;;
        bash)
            cat << 'EOF' | sed "s@##CMD_LIST_BASH##@$cmd_list_bash@g"
        _baotx_bash_completion() {

    local cur prev opts clusters config_list
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    config_list="${BAOTX_CONFIG:-$HOME/.baoconfig.yaml}"
    opts="##CMD_LIST_BASH##"

    local -a configs
    IFS=':' read -ra configs <<< "$config_list"
    local existing_configs=()
    for f in "${configs[@]}"; do [[ -f "$f" ]] && existing_configs+=("$f"); done

    if [[ ${#existing_configs[@]} -gt 0 ]]; then
        # Get both cluster names and their aliases from all files
        clusters=$(yq eval-all '(.clusters // {}) | to_entries | .[] | (.key, (.value.aliases // [] | .[]))' "${existing_configs[@]}" 2>/dev/null | grep -v "^null$" || true)
    fi

    if [ $COMP_CWORD -eq 1 ]; then
        COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
        return 0
    fi
    case "$prev" in
        login|select|namespace|ns|exec) COMPREPLY=( $(compgen -W "$clusters" -- "$cur") ); return 0 ;;
        status) COMPREPLY=( $(compgen -W "--format=env --format=json --policies --all" -- "$cur") ); return 0 ;;
        set-cli) COMPREPLY=( $(compgen -f -- "$cur") ); return 0 ;;
    esac
}
complete -F _baotx_bash_completion baotx
EOF
            ;;
        *) _error "Usage: baotx completion [zsh|bash]";;
    esac
}

# --- Main Dispatcher ---

_check_deps

COMMAND="${1:-help}"
shift || true

if declare -F "cmd_$COMMAND" >/dev/null; then
    # Run hooks for everything except completion and load to avoid noise/recursion
    if [[ "$COMMAND" != "completion" && "$COMMAND" != "load" ]]; then
        # Try to determine the cluster context for the hook
        hook_cluster=""
        case "$COMMAND" in
            select|exec|login)
                if [[ -n "${1:-}" && "${1:-}" != "-" ]]; then
                    hook_cluster=$(_resolve_alias "$1")
                else
                    hook_cluster=$(_get_config '.current-cluster')
                fi
                ;;
            *)
                hook_cluster=$(_get_config '.current-cluster')
                ;;
        esac

        _run_hook "pre" "$COMMAND" "$hook_cluster" "$@"
        "cmd_$COMMAND" "$@"
        _run_hook "post" "$COMMAND" "$hook_cluster" "$@"
    else
        "cmd_$COMMAND" "$@"
    fi
else
    _error "Unknown command: $COMMAND. Use 'baotx help' for a list of commands."
fi
